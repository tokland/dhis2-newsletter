<!DOCTYPE html>
<html>
<head>
<meta charset="utf-8">
<style>
  body { font-family: -apple-system, Helvetica, Arial, sans-serif; color: #1a1a1a; max-width: 640px; margin: 0 auto; padding: 16px; }
  h1 { font-size: 20px; }
  h2 { font-size: 16px; border-bottom: 1px solid #ddd; padding-bottom: 4px; margin-top: 28px; }
  .intro { color: #333; margin-bottom: 8px; }
  .item { margin: 10px 0; }
  .item a { color: #1a5fb4; text-decoration: none; font-weight: 600; }
  .item a:hover { text-decoration: underline; }
  .summary { margin: 2px 0 0; color: #333; }
  .item.highlight { border-left: 3px solid #d4380d; padding-left: 10px; background: #fff2ee; }
  .item.highlight .badge { color: #d4380d; font-weight: 700; font-size: 12px; }
  .footer { margin-top: 32px; font-size: 12px; color: #888; }
</style>
</head>
<body>
  <h1>DHIS2 Weekly Digest — {{ start }} to {{ end }}</h1>
  <p class="intro">{{ digest['intro'] }}</p>

  {% for section in digest['sections'] %}
  <h2>{{ section['name'] }}</h2>
  {% for item in section['items'] %}
  <div class="item{{ ' highlight' if item.get('highlight') else '' }}">
    {% if item.get('highlight') %}<div class="badge">⭐ EyeSeeTea</div>{% endif %}
    <a href="{{ item['url'] }}">{{ item['title'] }}</a>
    <p class="summary">{{ item['summary'] }}</p>
  </div>
  {% endfor %}
  {% endfor %}

  <p class="footer">Generated automatically from DHIS2 CoP, JIRA, GitHub, YouTube, Developer Portal, releases and the official newsletter.</p>
</body>
</html>
